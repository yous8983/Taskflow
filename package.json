{
  "name": "taskflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:client": "pnpm --filter client dev --host",
    "dev:server": "pnpm --filter server dev",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
